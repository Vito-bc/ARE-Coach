rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function ownerCanCreateUser(uid) {
      // termsAcceptedVersion/termsAcceptedAt and privacyAcceptedVersion/
      // privacyAcceptedAt are the entire legal record that the user agreed
      // to the Terms of Service and Privacy Policy at account creation
      // (Flutter: AuthService._ensureUserRecord). They are required, not
      // merely permitted, on every create -- a user document can only ever
      // come into existence with an assent record attached to it. Narrow
      // and typed: a size-capped version string plus a real timestamp, not
      // a widened field.
      return isOwner(uid)
        && request.resource.data.role == 'free'
        && request.resource.data.keys().hasOnly([
          'email',
          'name',
          'role',
          'targetExamDate',
          'createdAt',
          'lastActiveAt',
          'dailyLimits',
          'termsAcceptedVersion',
          'termsAcceptedAt',
          'privacyAcceptedVersion',
          'privacyAcceptedAt'
        ])
        && request.resource.data.keys().hasAll([
          'termsAcceptedVersion',
          'termsAcceptedAt',
          'privacyAcceptedVersion',
          'privacyAcceptedAt'
        ])
        && request.resource.data.termsAcceptedVersion is string
        && request.resource.data.termsAcceptedVersion.size() <= 20
        && request.resource.data.termsAcceptedAt is timestamp
        && request.resource.data.privacyAcceptedVersion is string
        && request.resource.data.privacyAcceptedVersion.size() <= 20
        && request.resource.data.privacyAcceptedAt is timestamp;
    }

    function ownerCanUpdateUser(uid) {
      // Only name and targetExamDate are user-editable; all other fields are server-owned.
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'targetExamDate'
        ]);
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if ownerCanCreateUser(uid) || isAdmin();
      allow update: if ownerCanUpdateUser(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /attempts/{uid}/sessions/{sessionId} {
      allow read, create: if isOwner(uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /analytics/{uid}/weakTopics/{topicId} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /coach_chats/{uid}/threads/{threadId} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /usage/{uid}/daily/{dateKey} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Tokens, original-transaction ownership and processing ledger are private
    // backend records. Even clients with an admin claim cannot read or write.
    match /appleBilling/{document=**} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'questionId', 'questionText', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'questionId', 'questionText', 'reason', 'comment', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in ['incorrect_answer', 'outdated', 'unclear_wording', 'other']
        // Type + size validation: admins read these in moderation, so cap
        // string lengths to block oversized-payload abuse and storage bloat.
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() <= 100
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() <= 2000
        && (request.resource.data.comment == null
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 1000))
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }
  }
}
